generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== משתמשים =====
model User {
  id               String   @id @default(cuid())
  employeeId       String   @unique  // מזהה ארגוני (מה-SSO)
  displayName      String
  email            String   @unique
  isAdmin          Boolean  @default(false)
  isContentAdmin   Boolean  @default(false)  // הרשאת ניהול חומרי הטמעה
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  visits       UserVisit[]
  contacts     ContactRequest[]
}

// ===== קטגוריות ראשיות (4 אייקון-כרטיסים בדף הבית) =====
model MainCategory {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  icon        String?          // שם אייקון או emoji
  color       String?          // צבע הקטגוריה (hex)
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  folders     CategoryFolder[]
}

// ===== תיקיות היררכיות פנימיות (Nested Folders) =====
model CategoryFolder {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  imageUrl       String?          // תמונה/לוגו לתיקייה
  icon           String?          // שם אייקון/אמוג׳י
  sortOrder      Int              @default(0)
  isActive       Boolean          @default(true)

  mainCategoryId Int
  mainCategory   MainCategory     @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)

  parentId       Int?
  parent         CategoryFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       CategoryFolder[] @relation("FolderHierarchy")

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  systems        System[]
  videos         Video[]

  @@index([mainCategoryId, parentId])
}

// ===== מערכות/אתרים =====
model System {
  id            Int             @id @default(autoincrement())
  name          String
  description   String?
  url           String
  imageUrl      String?         // תמונה/לוגו
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  tags          String[]        @default([])
  folderId      Int?
  folder        CategoryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  visits        UserVisit[]
}

// ===== היסטוריית ביקורים של משתמשים =====
model UserVisit {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemId  Int?
  system    System?  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  videoId   Int?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@index([userId, visitedAt])
}

// ===== פניות למנהל =====
model ContactRequest {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  type        String   // "תקלה" | "רעיון" | "דיווח" | "אחר"
  employeeId  String   // מזהה ארגוני
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      String   @default("new") // "new" | "in_progress" | "resolved"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== חומרי הטמעה – סרטונים =====
model Video {
  id             Int             @id @default(autoincrement())
  title          String
  description    String?
  fileName       String          // שם קובץ הוידאו בשרת (תחת uploads/videos/)
  thumbnailName  String?         // שם קובץ תמונת thumbnail (תחת uploads/thumbnails/)
  mimeType       String?         // לדוג׳ video/mp4
  fileSize       BigInt?         // גודל בבייטים
  duration       Float?          // אורך בשניות
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  tags           String[]        @default([])
  folderId       Int?
  folder         CategoryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  visits         UserVisit[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sortOrder, createdAt])
}

// ===== הודעות מערכת =====
model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  createdAt DateTime @default(now())
}
