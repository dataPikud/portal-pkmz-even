generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== משתמשים =====
model User {
  id               String   @id @default(cuid())
  employeeId       String   @unique  // מזהה ארגוני (מה-SSO)
  displayName      String
  email            String   @unique
  isAdmin          Boolean  @default(false)
  isContentAdmin   Boolean  @default(false)  // הרשאת ניהול חומרי הטמעה
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  visits       UserVisit[]
  contacts     ContactRequest[]
}

// ===== קטגוריות ראשיות (4 אייקון-כרטיסים בדף הבית) =====
model MainCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  icon        String?          // שם אייקון או emoji
  color       String?          // צבע הקטגוריה (hex)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subCategories SubCategory[]
}

// ===== קטגוריות משנה בתוך כל קטגוריה ראשית =====
model SubCategory {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  mainCategoryId Int
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  systems System[]
}

// ===== מערכות/אתרים =====
model System {
  id            Int          @id @default(autoincrement())
  name          String
  description   String?
  url           String
  imageUrl      String?      // תמונה/לוגו
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  subCategoryId Int?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  visits        UserVisit[]
}

// ===== היסטוריית ביקורים של משתמשים =====
model UserVisit {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemId  Int
  system    System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@index([userId, visitedAt])
}

// ===== פניות למנהל =====
model ContactRequest {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  type        String   // "תקלה" | "רעיון" | "דיווח" | "אחר"
  employeeId  String   // מזהה ארגוני
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      String   @default("new") // "new" | "in_progress" | "resolved"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== חומרי הטמעה – סרטונים =====
model Video {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  fileName       String            // שם קובץ הוידאו בשרת (תחת uploads/videos/)
  thumbnailName  String?           // שם קובץ תמונת thumbnail (תחת uploads/thumbnails/)
  mimeType       String?           // לדוג׳ video/mp4
  fileSize       BigInt?           // גודל בבייטים
  duration       Float?            // אורך בשניות
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder, createdAt])
}
