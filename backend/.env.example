# For LOCAL use only: running the backend on your own machine with "npm run dev",
# against a Postgres you installed yourself. Copy to backend/.env (never commit it).
# For Docker, use .env.dev.example and .env.prod.example at the repository root instead.

# Required: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/portal"

# Optional (defaults shown)
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info
