# Development environment. Copy to .env.dev (never commit it) and run:
#   npm run docker:dev:reset

# ===== Database (the db container) =====
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_dev_password
POSTGRES_DB=portal

# Docker Compose builds the backend's DATABASE_URL from POSTGRES_* (host "db", port 5432),
# so this value is ignored inside Docker. It is for tools you run on your own machine.
DATABASE_URL=postgresql://portal:portal_dev_password@localhost:5432/portal

# ===== Backend =====
NODE_ENV=development
# Fixed to 4000 inside Docker by the compose file. Used when running without Docker.
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ===== Frontend (Vite dev server) =====
# Where Vite forwards /api and /uploads. Fixed to http://backend:4000 inside Docker by the
# compose file. Used when running Vite on your own machine.
VITE_PROXY_TARGET=http://localhost:4000

# ===== File watching =====
# Bind mounts on Windows don't pass file events into containers, so watch by polling.
# Read by tsx (backend) and by vite.config.ts (frontend).
CHOKIDAR_USEPOLLING=true

# ===== Ports published on your machine =====
# Change only if a port is already taken (for example by another project). These are the
# only port settings that matter for Docker; remove the leading # to use one.
# DEV_DB_PORT=5432
# DEV_BACKEND_PORT=4000
# DEV_FRONTEND_PORT=5173
