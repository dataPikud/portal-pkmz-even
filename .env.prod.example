# Production environment. Copy to .env.prod on the server only (never commit it).
# Replace every CHANGE_ME value.

# ===== Database (the portal's own db container) =====
POSTGRES_USER=portal
# Use a strong password made of letters and digits only: it is also embedded in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=portal

# Docker Compose builds the backend's DATABASE_URL from POSTGRES_* (host "db", port 5432),
# so this value is ignored inside Docker. It is for tools you run by hand.
DATABASE_URL=postgresql://portal:CHANGE_ME@db:5432/portal

# ===== Backend =====
NODE_ENV=production
# Fixed to 4000 inside Docker by the compose file (nginx and the health check rely on it)
PORT=4000
# The address users open in the browser.
CORS_ORIGIN=http://localhost
LOG_LEVEL=info

# ===== Port published on the server =====
# Port the portal listens on. Change it only if port 80 is taken (for example, when testing locally).
# HTTP_PORT=80
